[Unit]
Description=tokenbooth booth: one login, as a user of its own

[Service]
DynamicUser=yes
# without it, every instance shares one user named after the template
User=tb-%i
PrivatePIDs=yes
PrivateIPC=yes
ProtectHome=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077
BindReadOnlyPaths=@REPO@:/opt/tokenbooth
# Chrome falls back to its Qt shim when GTK finds no display of its own, and Qt aborts on the
# missing display; without the shim the fallback fails cleanly
InaccessiblePaths=-/opt/google/chrome/libqt5_shim.so -/opt/google/chrome/libqt6_shim.so
WorkingDirectory=/opt/tokenbooth
ExecStart=/usr/bin/python3 -E -s -m tokenbooth.booth --engine chrome
StandardInput=null
StandardOutput=journal
StandardError=journal
RuntimeMaxSec=3600

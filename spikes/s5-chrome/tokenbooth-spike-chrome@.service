[Unit]
Description=tokenbooth spike S5: one Chrome booth

[Service]
DynamicUser=yes
ProtectHome=yes
BindReadOnlyPaths=@REPO@:/opt/tokenbooth-spike
# Chrome falls back to its Qt shim when GTK finds no display of its own, and Qt aborts on the
# missing display; without the shim the fallback fails cleanly
InaccessiblePaths=-/opt/google/chrome/libqt5_shim.so -/opt/google/chrome/libqt6_shim.so
ExecStart=/usr/bin/python3 -I /opt/tokenbooth-spike/spikes/s5-chrome/booth.py
StandardInput=null
StandardOutput=journal
StandardError=journal
Environment=HOME=/tmp
RuntimeMaxSec=900
